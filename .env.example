# Copy to .env only if you want to override the defaults.
# docker compose works without a .env file.

# Host ports (change these if something on your machine already uses them)
WEB_PORT=5173
API_PORT=3000
POSTGRES_PORT=5432

# Postgres credentials (used by the postgres container)
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp
POSTGRES_DB=erp

# Used when running the API on your machine (mvn spring-boot:run).
# Inside Docker the API connects to host "postgres" instead of "localhost".
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/erp
SPRING_DATASOURCE_USERNAME=erp
SPRING_DATASOURCE_PASSWORD=erp
