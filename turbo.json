{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalDependencies": [".env"],
  "globalPassThroughEnv": [
    "NODE_ENV",
    "PORT",
    "HOST",
    "SPRING_DATASOURCE_URL",
    "SPRING_DATASOURCE_USERNAME",
    "SPRING_DATASOURCE_PASSWORD",
    "API_PROXY_TARGET",
    "WATCH_POLLING",
    "CHOKIDAR_USEPOLLING",
    "TSC_WATCHFILE",
    "TSC_WATCHDIRECTORY"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "target/**"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "e2e": {
      "dependsOn": ["@erp/web#build"],
      "passThroughEnv": [
        "CI",
        "GITHUB_ACTIONS",
        "E2E_BASE_URL",
        "API_PORT",
        "WEB_PORT",
        "PLAYWRIGHT_BROWSERS_PATH"
      ],
      "cache": false
    }
  }
}
